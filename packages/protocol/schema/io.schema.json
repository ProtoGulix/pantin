{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          },
          "transport": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "modbus_tcp_slave"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535
                  },
                  "unitId": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 247
                  },
                  "wordOrder": {
                    "default": "low_word_first",
                    "type": "string",
                    "enum": ["low_word_first", "high_word_first"]
                  },
                  "watchdogMilliseconds": {
                    "default": 1000,
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 3600000
                  }
                },
                "required": ["kind", "port", "unitId", "wordOrder", "watchdogMilliseconds"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "opcua_client"
                  },
                  "port": {
                    "default": 4840,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "endpointPath": {
                    "default": "",
                    "type": "string",
                    "maxLength": 255
                  },
                  "securityMode": {
                    "default": "SignAndEncrypt",
                    "type": "string",
                    "enum": ["None", "Sign", "SignAndEncrypt"]
                  },
                  "securityPolicy": {
                    "default": "Basic256Sha256",
                    "type": "string",
                    "enum": [
                      "None",
                      "Basic256Sha256",
                      "Aes128_Sha256_RsaOaep",
                      "Aes256_Sha256_RsaPss"
                    ]
                  },
                  "auth": {
                    "default": {
                      "kind": "anonymous"
                    },
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "anonymous"
                          }
                        },
                        "required": ["kind"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "user"
                          },
                          "userName": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                          }
                        },
                        "required": ["kind", "userName"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "namespaceUri": {
                    "default": "",
                    "type": "string",
                    "maxLength": 255
                  },
                  "nodeIdPrefix": {
                    "default": "|var|CODESYS Control Win V3 x64.Application.",
                    "type": "string",
                    "maxLength": 255
                  },
                  "gvlName": {
                    "default": "GVL_Pantin",
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[A-Za-z][A-Za-z0-9]*(_[A-Za-z0-9]+)*$"
                  },
                  "samplingMilliseconds": {
                    "default": 20,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "publishingMilliseconds": {
                    "default": 20,
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 60000
                  },
                  "watchdogMilliseconds": {
                    "default": 1000,
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 3600000
                  }
                },
                "required": [
                  "kind",
                  "port",
                  "endpointPath",
                  "securityMode",
                  "securityPolicy",
                  "auth",
                  "namespaceUri",
                  "nodeIdPrefix",
                  "gvlName",
                  "samplingMilliseconds",
                  "publishingMilliseconds",
                  "watchdogMilliseconds"
                ],
                "additionalProperties": false
              }
            ]
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tag": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?\\.[a-z][a-z0-9_]{0,31}$"
                },
                "variable": {
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                },
                "modbus": {
                  "type": "object",
                  "properties": {
                    "zone": {
                      "type": "string",
                      "enum": ["coil", "discrete_input", "holding_register", "input_register"]
                    },
                    "address": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "ioType": {
                      "type": "string",
                      "enum": ["BOOL", "REAL", "DINT"]
                    }
                  },
                  "required": ["zone", "address", "ioType"],
                  "additionalProperties": false
                },
                "opcua": {
                  "type": "object",
                  "properties": {
                    "identifier": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "iecType": {
                      "type": "string",
                      "enum": ["BOOL", "REAL", "LREAL", "INT", "DINT", "LINT"]
                    }
                  },
                  "required": ["identifier", "iecType"],
                  "additionalProperties": false
                }
              },
              "required": ["tag", "variable", "comment"],
              "additionalProperties": false
            }
          }
        },
        "required": ["key", "transport", "channels"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "modules"],
  "additionalProperties": false,
  "title": "Pantin I/O mapping (io.json)",
  "description": "Shape of the I/O mapping of a Pantin. Whether each tag exists, fits its zone and type, and whether addresses overlap is checked against pantin.json by the core."
}
