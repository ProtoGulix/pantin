{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          },
          "transport": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "modbus_tcp_slave"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535
                  },
                  "unitId": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 247
                  },
                  "wordOrder": {
                    "default": "low_word_first",
                    "type": "string",
                    "enum": ["low_word_first", "high_word_first"]
                  },
                  "watchdogMilliseconds": {
                    "default": 1000,
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 3600000
                  }
                },
                "required": ["kind", "port", "unitId", "wordOrder", "watchdogMilliseconds"],
                "additionalProperties": false
              }
            ]
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tag": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?\\.[a-z][a-z0-9_]{0,31}$"
                },
                "variable": {
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                },
                "modbus": {
                  "type": "object",
                  "properties": {
                    "zone": {
                      "type": "string",
                      "enum": ["coil", "discrete_input", "holding_register", "input_register"]
                    },
                    "address": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "ioType": {
                      "type": "string",
                      "enum": ["BOOL", "REAL", "DINT"]
                    }
                  },
                  "required": ["zone", "address", "ioType"],
                  "additionalProperties": false
                }
              },
              "required": ["tag", "variable", "comment"],
              "additionalProperties": false
            }
          }
        },
        "required": ["key", "transport", "channels"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "modules"],
  "additionalProperties": false,
  "title": "Pantin I/O mapping (io.json)",
  "description": "Shape of the I/O mapping of a Pantin. Whether each tag exists, fits its zone and type, and whether addresses overlap is checked against pantin.json by the core."
}
