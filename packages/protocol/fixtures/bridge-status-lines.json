      "name": "ready with one module",
      "message": {
        "event": "ready",
        "transport": "modbus_tcp_slave",
        "listen": "127.0.0.1",
        "modules": [
          {
            "key": "m1",
            "port": 1502
          }
        ]
      }
    },
    {
      "name": "ready with two modules on a private address",
      "message": {
        "event": "ready",
        "transport": "modbus_tcp_slave",
