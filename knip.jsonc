{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["tests/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/opcua-bridge": {
      "project": ["src/**/*.ts"],
      // Spawned by the stdout guard test, never imported.
      "entry": ["src/test-support/guard-probe.ts"]
    }
  }
}
